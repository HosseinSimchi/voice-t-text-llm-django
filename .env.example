# Copy to .env and fill in. NEVER commit .env.
DJANGO_SECRET_KEY=change-me-generate-with-python-c-secrets.token_urlsafe-64
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Set to false only when serving plain HTTP locally (Docker without TLS proxy).
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_COOKIES=false
DJANGO_BEHIND_PROXY=false
SITE_BASE_URL=http://localhost:8000
TIME_ZONE=Asia/Tehran

# Database (docker-compose uses postgres; local dev defaults to sqlite)
DB_ENGINE=sqlite
POSTGRES_DB=audio_intelligence
POSTGRES_USER=audio
POSTGRES_PASSWORD=change-me-db-password

# Broker / cache
REDIS_URL=redis://localhost:6379/0
# CACHE_REDIS_URL=redis://localhost:6379/1
# Local development without Redis: run tasks inline (not for production).
CELERY_TASK_ALWAYS_EAGER=false

# LLM endpoint override (deployment-specific; the model itself is in config/ai/settings.yaml)
LLM_BASE_URL=http://localhost:11434

# SMTP (all credentials come from the environment)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Audio Intelligence <no-reply@example.com>

# Rate limits
THROTTLE_UPLOADS=20/hour
THROTTLE_STATUS=600/hour
THROTTLE_DOWNLOADS=300/hour

# Workers
CELERY_CONCURRENCY=1
GUNICORN_WORKERS=3
LOG_LEVEL=INFO

# --- Docker only ---
# Published address of the web container (127.0.0.1 = this machine only; use a reverse proxy for public access).
# WEB_BIND=127.0.0.1
# WEB_PORT=8000
# LLM: by default containers use the Ollama running on the host. For Ollama inside Docker use:
#   DOCKER_LLM_BASE_URL=http://ollama:11434   and start with:  docker compose --profile ollama up -d
# DOCKER_LLM_BASE_URL=http://ollama:11434
