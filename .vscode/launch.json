{
  // Run/debug configurations. Pick "Run all (web + worker + beat)" in the Run and Debug view, then press F5.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: web server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["runserver", "127.0.0.1:8000", "--noreload"],
      "django": true,
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "env": {
        "CELERY_FILESYSTEM_BROKER_DIR": "${workspaceFolder}/media/.broker",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "name": "Celery: worker",
      "type": "debugpy",
      "request": "launch",
      "module": "celery",
      "args": ["-A", "config", "worker", "--pool=solo", "--loglevel=INFO"],
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "env": {
        "CELERY_FILESYSTEM_BROKER_DIR": "${workspaceFolder}/media/.broker",
        "HF_HUB_DISABLE_SYMLINKS_WARNING": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "name": "Celery: beat",
      "type": "debugpy",
      "request": "launch",
      "module": "celery",
      "args": ["-A", "config", "beat", "--loglevel=INFO", "--schedule", "media/.celerybeat-schedule"],
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "env": {
        "CELERY_FILESYSTEM_BROKER_DIR": "${workspaceFolder}/media/.broker",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "name": "Django: web server (single process, no worker)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["runserver", "127.0.0.1:8000", "--noreload"],
      "django": true,
      "cwd": "${workspaceFolder}",
      "env": {"CELERY_TASK_ALWAYS_EAGER": "true", "PYTHONIOENCODING": "utf-8"}
    }
  ],
  "compounds": [
    {
      "name": "Run all (web + worker + beat)",
      "configurations": ["Django: web server", "Celery: worker", "Celery: beat"],
      "stopAll": true
    }
  ]
}
